const decodeConfigValue = value => new TextDecoder().decode(
    Uint8Array.from(atob(value), character => character.charCodeAt(0)))
const APP_CONFIG = {
    OAUTH_CLIENT_ID: decodeConfigValue("${ADMIN_OAUTH_CLIENT_ID_B64}"),
    OAUTH_AUTHORITY: decodeConfigValue("${ADMIN_OAUTH_AUTHORITY_B64}"),
    ADMIN_PUBLIC_URL: decodeConfigValue("${ADMIN_PUBLIC_URL_B64}"),
    OAUTH_SCOPE: decodeConfigValue("${ADMIN_OAUTH_SCOPE_B64}")
}
globalThis.APP_CONFIG = APP_CONFIG
