VITE_APP_PROXY=false
VITE_APP_TITLE=macula-cloud
VITE_APP_API_BASEURL=/api

MACULA_CLOUD_IAM_URL=http://127.0.0.1:9010

# 独立公共 SPA Client，由部署配置；浏览器中不配置密钥。
VITE_APP_OAUTH_CLIENT_ID=
VITE_APP_OAUTH_AUTHORITY=http://127.0.0.1:9010
VITE_APP_ADMIN_PUBLIC_URL=http://127.0.0.1:5900
VITE_APP_OAUTH_SCOPE=openid profile
