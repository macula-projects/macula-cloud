# 本文件仅用于本地开发示例。复制为 deploy/.env 后再按需修改，禁止填写真实环境凭据。
COMPOSE_PROJECT_NAME=macula-cloud-dev
BIND_ADDRESS=127.0.0.1

MYSQL_IMAGE=mysql:8.4.6
MYSQL_PORT=13306
MYSQL_ROOT_PASSWORD=macula-root
MYSQL_APP_USER=macula
MYSQL_APP_PASSWORD=macula

REDIS_IMAGE=redis:7.4.5-alpine
REDIS_PORT=16379

NACOS_IMAGE=nacos/nacos-server:v3.2.4
NACOS_SERVER_PORT=18848
NACOS_CONSOLE_PORT=18080
NACOS_GRPC_PORT=19848
NACOS_NAMESPACE=MACULA5
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos
NACOS_AUTH_TOKEN=VGhpc0lzTG9jYWxEZXZlbG9wbWVudFRva2VuS2V5MDEyMzQ1Njc4OQ==
NACOS_AUTH_IDENTITY_KEY=macula-local-key
NACOS_AUTH_IDENTITY_VALUE=macula-local-value

ROCKETMQ_IMAGE=apache/rocketmq:5.3.1
ROCKETMQ_NAMESRV_PORT=9876
ROCKETMQ_BROKER_PORT=10911
ROCKETMQ_HA_PORT=10912
ROCKETMQ_FAST_PORT=10909

# Cloud 应用镜像和本机端口，仅在 apps profile 中使用。
IMAGE_REGISTRY=macula
IMAGE_TAG=6.1.0-SNAPSHOT
JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -Djava.security.egd=file:/dev/./urandom
GATEWAY_HOST_PORT=9000
IAM_HOST_PORT=9010
SYSTEM_HOST_PORT=9081
TINYID_HOST_PORT=9082
ROCKETMQ_ADMIN_HOST_PORT=9083
DOCS_HOST_PORT=9084
SNAILJOB_HTTP_HOST_PORT=9086
SNAILJOB_GRPC_HOST_PORT=17888
SEATA_HTTP_HOST_PORT=9091
SEATA_SERVICE_HOST_PORT=8091
ADMIN_HOST_PORT=5900

# 仅限本地开发的示例值，进入共享环境前必须替换。
VITE_APP_OAUTH_CLIENT_ID=e4da4a32-592b-46f0-ae1d-784310e88423
VITE_APP_OAUTH_CLIENT_SECRET=secret
VITE_APP_OAUTH_SCOPE=message.read message.write userinfo
VITE_APP_DEMO_USERNAME=admin
VITE_APP_DEMO_PASSWORD=admin

SEATA_SECRET_KEY=U2VhdGFMb2NhbERldmVsb3BtZW50U2VjcmV0S2V5MDEyMzQ1Njc4OQ==
SEATA_CONSOLE_USERNAME=seata
SEATA_CONSOLE_PASSWORD=seata

# 公开的本机演示密钥，不能用于业务客户端、共享环境或生产环境。
IAM_PLAYGROUND_CLIENT_SECRET=bf1990c1c38cae4beb4c175075585aec14a546a5ff2e2a38b8ee3f219dadbea8
IAM_ISSUER_URI=http://127.0.0.1:9010
IAM_PLAYGROUND_ENABLED=true
IAM_PLAYGROUND_ALLOWED_PROFILES=docker
IAM_PLAYGROUND_ALLOW_LOOPBACK_HTTP=true
