<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="dev.macula.cloud.tinyid.mapper.TinyIdTokenMapper">

    <sql id="applicationColumns">
        MIN(id) AS app_id,
        token,
        MAX(remark) AS remark,
        MIN(create_time) AS create_time,
        MAX(update_time) AS update_time
    </sql>

    <select id="selectApplicationPage" resultType="dev.macula.cloud.tinyid.pojo.bo.TinyIdApplicationBO">
        SELECT <include refid="applicationColumns"/>
        FROM tiny_id_token
        <where>
            <if test="keywords != null and keywords.trim() != ''">
                remark LIKE CONCAT('%', #{keywords}, '%')
            </if>
        </where>
        GROUP BY token
        ORDER BY app_id DESC
    </select>

    <select id="selectApplicationById" resultType="dev.macula.cloud.tinyid.pojo.bo.TinyIdApplicationBO">
        SELECT <include refid="applicationColumns"/>
        FROM tiny_id_token
        WHERE token = (SELECT token FROM tiny_id_token WHERE id = #{appId})
        GROUP BY token
    </select>

    <select id="selectApplicationByToken" resultType="dev.macula.cloud.tinyid.pojo.bo.TinyIdApplicationBO">
        SELECT <include refid="applicationColumns"/>
        FROM tiny_id_token
        WHERE token = #{token}
        GROUP BY token
    </select>

</mapper>
